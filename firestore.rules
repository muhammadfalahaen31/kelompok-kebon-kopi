rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isAdmin() {
      return hasRole('super_admin') || hasRole('admin');
    }

    function isPengurus() {
      return isAuthenticated() && (
        getUserData().role == 'super_admin' || 
        getUserData().role == 'admin' || 
        getUserData().role == 'pengurus'
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isPengurus();
      allow write: if isSuperAdmin() || request.auth.uid == userId;
    }

    // 2. Jamaah collection (Strictly minimalist: Nama & Jenis Kelamin)
    match /jamaah/{jamaahId} {
      allow read: if isPengurus();
      allow write: if isAdmin();
    }

    // 3. Pengajian Schedules
    match /pengajian/{pengajianId} {
      allow read: if true; // Public can see general schedules
      allow write: if isAdmin();
    }

    // 4. Attendance Records (Protected internal)
    match /attendance/{attendanceId} {
      allow read: if isPengurus();
      allow write: if isAdmin();
    }

    // 5. Penerobos Jobdesk
    match /penerobos/{jobdeskId} {
      allow read: if isPengurus();
      allow write: if isAdmin();
    }

    // 6. Musyawarah Decisions & Progress
    match /musyawarah/{decisionId} {
      allow read: if isPengurus();
      allow write: if isAdmin();
    }

    // 7. Activity Logs (Audit)
    match /activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only audit log
    }

    // 8. Documents
    match /documents/{docId} {
      allow read: if isPengurus() || resource.data.isPublic == true;
      allow write: if isAdmin();
    }

    // 9. Public Content & Settings
    match /public_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isPengurus();
      allow write: if isSuperAdmin();
    }
  }
}
